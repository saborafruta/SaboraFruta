DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production-use-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://erp:erp@localhost:5432/erp_inoovated

# Bancos separados por empresa. Mantenha False até concluir backup, ensaio de
# migração e validação de cada empresa.
TENANT_DATABASE_ROUTING_ENABLED=False
TENANT_DATABASE_PROVISIONING_MODE=manual
# Travas de implantação: só marque True depois de adaptar links públicos e Celery.
TENANT_PUBLIC_LINK_ROUTING_READY=False
TENANT_BACKGROUND_TASKS_READY=False
# TENANT_DATABASES_JSON={"empresa_demo":"postgres://erp:erp@localhost:5432/erp_empresa_demo"}
# Para provisionamento automático no Railway: railway_api + token do projeto.
RAILWAY_PROJECT_TOKEN=
RAILWAY_API_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_SERVICE_ID=
RAILWAY_TENANT_DATABASE_IMAGE=postgres:16-alpine
RAILWAY_TENANT_DATABASE_VOLUME_PATH=/var/lib/postgresql/data

# Futuro Supabase/Postgres externo.
# Nao usar dados reais no plano free e nao commitar URLs reais com senha.
# DATABASE_URL=postgres://postgres.PROJECT_REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# DATABASE_SSL_REQUIRE=True
# DATABASE_CONN_MAX_AGE=0

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=django-db

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@inoovated.com.br

# Uploads locais. No Railway, monte um Volume em /app/media e use MEDIA_ROOT=/app/media.
# Sem volume, a imagem pode ate salvar, mas some em novo deploy/restart.
MEDIA_URL=/media/
MEDIA_ROOT=media

# ViaCEP
VIACEP_URL=https://viacep.com.br/ws/{cep}/json/

# Futuro Cloudflare/R2.
# Manter desativado no MVP de custo zero. Quando migrar arquivos, configurar
# storage externo com variaveis proprias e testar restauracao antes de producao.

# Focus NFe (https://app.focusnfe.com.br) - emissao de documentos fiscais
# FOCUSNFE_AMBIENTE: 1=producao, 2=homologacao
FOCUSNFE_TOKEN=
FOCUSNFE_AMBIENTE=2
# Token livre que protege o endpoint /fiscal/webhook/focusnfe/ (opcional)
FOCUSNFE_WEBHOOK_TOKEN=
